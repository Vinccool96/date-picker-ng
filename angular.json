{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "date-picker-ng": {
      "projectType": "library",
      "root": "projects/date-picker-ng",
      "sourceRoot": "projects/date-picker-ng/src",
      "prefix": "dp",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/date-picker-ng/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/date-picker-ng/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/date-picker-ng/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/date-picker-ng/src/test.ts",
            "tsConfig": "projects/date-picker-ng/tsconfig.spec.json",
            "karmaConfig": "projects/date-picker-ng/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/**/*.ts",
              "projects/**/*.html"
            ]
          }
        }
      },
      "schematics": {
        "@schematics/angular:component": {
          "prefix": "dp",
          "style": "less"
        },
        "@schematics/angular:directive": {
          "prefix": "dp"
        }
      }
    },
    "date-picker-ng-demo": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "less"
        }
      },
      "root": "projects/date-picker-ng-demo",
      "sourceRoot": "projects/date-picker-ng-demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/date-picker-ng-demo/src/main.ts",
            "tsConfig": "projects/date-picker-ng-demo/tsconfig.app.json",
            "inlineStyleLanguage": "less",
            "polyfills": [
              "projects/date-picker-ng-demo/src/polyfills.ts"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/date-picker-ng-demo/public"
              }
            ],
            "styles": [
              "projects/date-picker-ng-demo/src/styles.less",
              "node_modules/@angular/cdk/overlay-prebuilt.css"
            ],
            "scripts": [],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "projects/date-picker-ng-demo/src/environments/environment.ts",
                  "with": "projects/date-picker-ng-demo/src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "date-picker-ng-demo:build:production"
            },
            "development": {
              "buildTarget": "date-picker-ng-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/date-picker-ng-demo/src/test.ts",
            "karmaConfig": "projects/date-picker-ng-demo/karma.conf.js",
            "polyfills": "projects/date-picker-ng-demo/src/polyfills.ts",
            "tsConfig": "projects/date-picker-ng-demo/tsconfig.spec.json",
            "scripts": [],
            "styles": [
              "projects/date-picker-ng-demo/src/styles.less"
            ],
            "assets": [
              "projects/date-picker-ng-demo/public"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/date-picker-ng-demo/**/*.ts",
              "projects/date-picker-ng-demo/**/*.html"
            ],
            "eslintConfig": "projects/date-picker-ng-demo/eslint.config.mjs"
          }
        }
      }
    },
    "date-picker-ng-demo-e2e": {
      "root": "",
      "sourceRoot": "e2e",
      "projectType": "application",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "./protractor.conf.js",
            "devServerTarget": "date-picker-ng-demo:serve"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "demo",
      "style": "less"
    },
    "@schematics/angular:directive": {
      "prefix": "demo"
    }
  },
  "cli": {
    "schematicCollections": [
      "angular-eslint"
    ]
  }
}

{
  "name": "date-picker-ng-workspace",
  "author": "Vincent Girard <vinccool96@gmail.com> (https://vinccool96.github.io/)",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "start:open": "ng serve --o",
    "build": "ng build",
    "build:lib": "ng build date-picker-ng",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "test:ci:lib": "ng test date-picker-ng --watch=true --browsers=ChromeHeadless",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "lint:lib": "ng lint date-picker-ng",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "build:demo": "rm -rf dist/ && ng build ng2-date-picker-demo --configuration production && npm run build:index",
    "release": "npm run build:lib && cd dist/date-picker-ng && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vinccool/date-picker-ng.git"
  },
  "keywords": [
    "angular2",
    "date",
    "datepicker",
    "date-picker",
    "ng2-datepicker",
    "ng-datepicker",
    "angular",
    "picker",
    "angular-datepicker",
    "date-picker-ng"
  ],
  "dependencies": {
    "@angular/cdk": "^21.1.3",
    "dayjs": "^1.11.13",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.1.3",
    "@angular-devkit/core": "^21.1.3",
    "@angular/animations": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/common": "^21.1.3",
    "@angular/compiler": "^21.1.3",
    "@angular/compiler-cli": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/forms": "^21.1.3",
    "@angular/platform-browser": "^21.1.3",
    "@angular/platform-browser-dynamic": "^21.1.3",
    "@angular/router": "^21.1.3",
    "@eslint/compat": "^2.0.5",
    "@eslint/config-helpers": "^0.6.0",
    "@eslint/js": "^9.39.4",
    "@ngneat/spectator": "^22.1.0",
    "@playwright/test": "^1.40.1",
    "@types/google.analytics": "^0.0.42",
    "@types/jasmine": "^4.3.1",
    "@types/node": "^18.15.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.4.0",
    "jasmine-core": "^4.6.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "^3.2.0",
    "karma-cli": "^2.0.0",
    "karma-coverage": "^2.2.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "less": "^4.1.3",
    "ng-packagr": "^21.1.0",
    "playwright": "^1.40.1",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "rxjs": "^6.5.3",
    "ts-node": "^10.9.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.1",
    "zone.js": "~0.15.0"
  },
  "angularCompilerOptions": {
    "skipTemplateCodegen": true,
    "strictMetadataEmit": true
  }
}

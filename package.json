{
  "name": "date-picker-ng-workspace",
  "author": "Vincent Girard <vinccool96@gmail.com> (https://vinccool96.github.io/)",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "start:open": "ng serve --o",
    "build": "ng build",
    "build:lib": "pnpm run clean:lib && ng build date-picker-ng --configuration=production",
    "build:demo": "pnpm run clean:demo && ng build date-picker-ng-demo --configuration production",
    "clean": "pnpm run clean:lib && pnpm run clean:demo",
    "clean:lib": "rimraf --glob packages/date-picker-ng/**/index.{d.ts,js,js.map,metadata.json} packages/date-picker-ng/schematics/**/*.{d.ts,js,map} dist/date-picker-ng/**/*",
    "clean:demo": "rimraf --glob packages/date-picker-ng-demo/**/*.{d.ts,js,map,metadata.json} dist/date-picker-ng-demo/**/*",
    "test": "ng test",
    "test:ci": "ng test --no-watch",
    "test:ci:lib": "ng test date-picker-ng --no-watch",
    "test:ci:demo": "ng test date-picker-ng-demo --no-watch",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "lint:lib": "ng lint date-picker-ng",
    "lint:lib:fix": "ng lint date-picker-ng --fix",
    "lint:demo": "ng lint date-picker-ng-demo",
    "lint:demo:fix": "ng lint date-picker-ng-demo --fix",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "release": "npm run build:lib && cd dist/date-picker-ng && npm publish",
    "postinstall": "pnpm exec husky",
    "commit:check": "lint-staged"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vinccool96/date-picker-ng.git"
  },
  "keywords": [
    "angular2",
    "date",
    "datepicker",
    "date-picker",
    "ng2-datepicker",
    "ng-datepicker",
    "angular",
    "picker",
    "angular-datepicker",
    "date-picker-ng"
  ],
  "dependencies": {
    "@angular/cdk": "^21.1.3",
    "dayjs": "^1.11.13",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@angular/animations": "^21.1.3",
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/common": "^21.1.3",
    "@angular/compiler": "^21.1.3",
    "@angular/compiler-cli": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/forms": "^21.1.3",
    "@angular/platform-browser": "^21.1.3",
    "@angular/platform-browser-dynamic": "^21.1.3",
    "@angular/router": "^21.1.3",
    "@eslint/compat": "^2.0.5",
    "@eslint/config-helpers": "^0.6.0",
    "@eslint/js": "^10.0.1",
    "@ngneat/spectator": "^22.1.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.0",
    "@vitest/eslint-plugin": "^1.6.20",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.10",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^70.0.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "ng-packagr": "^21.1.0",
    "playwright": "^1.61.1",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "rxjs": "^6.5.3",
    "ts-node": "^10.9.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9",
    "zone.js": "~0.15.0"
  },
  "angularCompilerOptions": {
    "skipTemplateCodegen": true,
    "strictMetadataEmit": true
  }
}
